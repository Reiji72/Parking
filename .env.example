# คัดลอกไฟล์นี้เป็น .env แล้วแก้ตามเครื่องของคุณ
DATABASE_URL=postgres://parking:parking@localhost:5432/parking
PORT=3000

# เขตเวลาที่ใช้จัดกลุ่มรายงานรายชั่วโมง
APP_TZ=Asia/Bangkok

# เปิด/ปิดหน้าจำลองเวลา (เลื่อนนาฬิการะบบเพื่อทดสอบ no-show) — ใช้งานจริงตั้งเป็น false
ALLOW_TIME_TRAVEL=true

# ความถี่ที่ระบบตรวจ no-show อัตโนมัติ (วินาที)
SWEEP_INTERVAL_SECONDS=30
